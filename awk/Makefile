# awk - pattern scanning and processing language (POSIX.1-2024)
#
# Targets: all (the default), test, difftest, install, clean.
#
# The parser is generated by yacc from awk.y and the scanner by lex from
# awk.l; the generated files are included, so neither is needed to build.

.POSIX:

CC       = cc
CFLAGS   = -O2
LDFLAGS  =
PREFIX   = /usr/local
BINDIR   = $(PREFIX)/bin
YACC     = yacc
LEX      = lex

# required by the sources: the language standard; and the warnings
STDFLAGS = -std=c11 -Wall -Wextra -Wno-format-nonliteral
LDLIBS   = -lm

PROG     = awk
OBJS     = main.o parse.o awk.tab.o lex.o run.o lib.o

all: $(PROG)

$(PROG): $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(OBJS): awk.h
parse.o awk.tab.o lex.o: parse.h awk.tab.h

.c.o:
	$(CC) $(STDFLAGS) $(CFLAGS) -c $<

awk.tab.c awk.tab.h: awk.y
	$(YACC) -d -b awk awk.y

lex.c: awk.l
	$(LEX) -t awk.l > lex.c

# the generated scanner includes <stdio.h> before the definitions in awk.l
lex.o: lex.c
	$(CC) $(STDFLAGS) $(CFLAGS) -D_POSIX_C_SOURCE=200809L -D_XOPEN_SOURCE=700 -c lex.c

test: all
	sh ./test_awk.sh

# compares with other implementations; needs
#   gawk (REF="gawk --posix" by default)
difftest: all
	sh ./tests/diff.sh

install: all
	mkdir -p $(DESTDIR)$(BINDIR)
	cp $(PROG) $(DESTDIR)$(BINDIR)/$(PROG)

clean:
	rm -f $(PROG) $(OBJS)

.PHONY: all test difftest install clean
