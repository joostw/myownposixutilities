-- SIGINT removes the target being made
echo partial > out; sleep 10
make: *** Deleting file 'out'
make: *** [out] Interrupt
status signal SIGINT
ls: cannot access 'out': No such file or directory
-- an unchanged existing target stays
sleep 10
make: *** [out] Terminated
status signal SIGTERM
old
-- directories are not removed
mkdir -p dir; sleep 10
make: *** [dir] Hangup
status signal SIGHUP
dir
-- .PRECIOUS targets are kept
echo x > p; sleep 10
make: *** [p] Interrupt
status signal SIGINT
p
-- an ignored signal stays ignored
echo x > q; sleep 1
status 0
q
-- -n does not catch signals
sleep 10
status signal SIGTERM
