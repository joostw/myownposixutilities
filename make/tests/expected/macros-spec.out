IMM=[1 $x] KEEP=[1 $x] DEL=[2 $x]
IA=[a 2 $y] DA=[a 2 $y]
SH=[lead  mid end] SH2=[] C=[c1]
IMM=[1 $x] KEEP=[1 $x] DEL=[2 $x]
IA=[a 2 $y] DA=[a 2 $y]
SH=[lead  mid end] SH2=[] C=[c1]
IMM=[env $x] KEEP=[env $x] DEL=[env $x]
