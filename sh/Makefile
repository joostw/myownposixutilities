# sh - shell, the standard command language interpreter (POSIX.1-2024)
#
# Targets: all (the default), test, difftest, install, clean.
#
# The parsers are generated by yacc (sh.y: the shell grammar; arith.y:
# arithmetic expansion) and the arithmetic scanner by lex (arith.l).
# The generated files are included, so neither is needed to build.

.POSIX:

CC       = cc
CFLAGS   = -O2
LDFLAGS  =
PREFIX   = /usr/local
BINDIR   = $(PREFIX)/bin
YACC     = yacc
LEX      = lex

# required by the sources: the language standard; and the warnings
STDFLAGS = -std=c11 -Wall -Wextra -Wno-format-nonliteral -Wno-unused-parameter
LDLIBS   =

PROG     = sh
OBJS     = main.o util.o var.o input.o parser.o sh.tab.o expand.o \
	   arith.tab.o arith_scan.o exec.o jobs.o builtins.o bltin2.o edit.o

all: $(PROG)

$(PROG): $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(OBJS): sh.h
parser.o sh.tab.o: parse.h sh.tab.h
arith.tab.o arith_scan.o: arith.h arith.tab.h

.c.o:
	$(CC) $(STDFLAGS) $(CFLAGS) -c $<

sh.tab.c sh.tab.h: sh.y
	$(YACC) -d -p shy -b sh sh.y

arith.tab.c arith.tab.h: arith.y
	$(YACC) -d -b arith arith.y

arith_scan.c: arith.l
	$(LEX) -t arith.l > arith_scan.c

# the generated scanner includes <stdio.h> before the definitions in arith.l
arith_scan.o: arith_scan.c
	$(CC) $(STDFLAGS) $(CFLAGS) -D_POSIX_C_SOURCE=200809L -D_XOPEN_SOURCE=700 -c arith_scan.c

test: all
	sh ./test_sh.sh

# compares with other implementations; needs
#   dash, bash, yash, busybox and mksh (the majority is the reference)
difftest: all
	python3 tests/run_diff.py

install: all
	mkdir -p $(DESTDIR)$(BINDIR)
	cp $(PROG) $(DESTDIR)$(BINDIR)/$(PROG)

clean:
	rm -f $(PROG) $(OBJS)

.PHONY: all test difftest install clean
