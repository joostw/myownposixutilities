# bc - arbitrary-precision arithmetic language (POSIX.1-2024)
#
# Targets: all (the default), test, difftest, install, clean.
#
# bc.tab.c, bc.tab.h and scan.c are generated by yacc and lex from bc.y
# and scan.l; they are included, so neither is needed to build.

.POSIX:

CC       = cc
CFLAGS   = -O2
LDFLAGS  =
PREFIX   = /usr/local
BINDIR   = $(PREFIX)/bin
YACC     = yacc
LEX      = lex

# required by the sources: the language standard; and the warnings
STDFLAGS = -std=c11 -Wall -Wextra
LDLIBS   = -lpthread

PROG     = bc
OBJS     = main.o exec.o num.o mathlib.o bc.tab.o scan.o

all: $(PROG)

$(PROG): $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(OBJS): bc.h num.h
bc.tab.o scan.o: bc.tab.h

.c.o:
	$(CC) $(STDFLAGS) $(CFLAGS) -c $<

bc.tab.c bc.tab.h: bc.y
	$(YACC) -d -b bc bc.y

scan.c: scan.l
	$(LEX) -t scan.l > scan.c

test: all
	sh ./test_bc.sh

# compares with other implementations; needs
#   GNU bc
difftest: all
	python3 tests/difftest.py ./bc
	python3 tests/randbc.py ./bc 1 300

install: all
	mkdir -p $(DESTDIR)$(BINDIR)
	cp $(PROG) $(DESTDIR)$(BINDIR)/$(PROG)

clean:
	rm -f $(PROG) $(OBJS)

.PHONY: all test difftest install clean
